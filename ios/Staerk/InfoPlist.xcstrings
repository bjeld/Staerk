    "CFBundleSpokenName" : {
      "comment" : "Accessibility bundle name: STRK is pronounced as the Danish word for strong",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stærk"
          }
        },
        "en" : {
